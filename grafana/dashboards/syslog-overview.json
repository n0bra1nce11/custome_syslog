{
  "id": null,
  "uid": "syslog-overview",
  "title": "Syslog Overview",
  "tags": ["syslog", "rsyslog", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"syslog\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "severity",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"syslog\"}, severity)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"syslog\"}, app)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Log Lines (range)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"syslog\", host=~\"$host\", severity=~\"$severity\", app=~\"$app\"} [$__range]))",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "title": "Error/Critical/Alert/Emergency (range)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"syslog\", host=~\"$host\", app=~\"$app\", severity=~\"emerg|alert|crit|err\"} [$__range]))",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "title": "Active Hosts (range)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "count(count by (host) (count_over_time({job=\"syslog\", host=~\"$host\", severity=~\"$severity\", app=~\"$app\"} [$__range])))",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "title": "Active Applications (range)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "count(count by (app) (count_over_time({job=\"syslog\", host=~\"$host\", severity=~\"$severity\", app=~\"$app\"} [$__range])))",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "title": "Log Volume Over Time (by severity)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (severity) (count_over_time({job=\"syslog\", host=~\"$host\", severity=~\"$severity\", app=~\"$app\"} [$__interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Severity Distribution (range)",
      "type": "piechart",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "targets": [
        {
          "expr": "sum by (severity) (count_over_time({job=\"syslog\", host=~\"$host\", severity=~\"$severity\", app=~\"$app\"} [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Top 10 Hosts (range)",
      "type": "bargauge",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "topk(10, sum by (host) (count_over_time({job=\"syslog\", host=~\"$host\", severity=~\"$severity\", app=~\"$app\"} [$__range])))",
          "refId": "A"
        }
      ],
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 8,
      "title": "Top 10 Applications (range)",
      "type": "bargauge",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "topk(10, sum by (app) (count_over_time({job=\"syslog\", host=~\"$host\", severity=~\"$severity\", app=~\"$app\"} [$__range])))",
          "refId": "A"
        }
      ],
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 9,
      "title": "Facility Distribution (range)",
      "type": "bargauge",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "sum by (facility) (count_over_time({job=\"syslog\", host=~\"$host\", severity=~\"$severity\", app=~\"$app\"} [$__range]))",
          "refId": "A"
        }
      ],
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 10,
      "title": "Errors & Above (live)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "{job=\"syslog\", host=~\"$host\", app=~\"$app\", severity=~\"emerg|alert|crit|err\"}",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    },
    {
      "id": 11,
      "title": "Live Log Stream (all)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "{job=\"syslog\", host=~\"$host\", severity=~\"$severity\", app=~\"$app\"}",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    },
    {
      "id": 12,
      "title": "Failed Windows Logon Attempts (range)",
      "type": "stat",
      "description": "Windows Security log event 4625. These arrive at severity=info, not err/crit, since Windows classifies Security events as Audit Success/Failure rather than by severity - so this is matched on the event's own message text instead of the severity filter.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"syslog\", host=~\"$host\"} |= \"An account failed to log on\" [$__range]))",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 13,
      "title": "Failed Windows Logon Attempts (live)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 42 },
      "targets": [
        {
          "expr": "{job=\"syslog\", host=~\"$host\"} |= \"An account failed to log on\"",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    },
    {
      "id": 14,
      "title": "Hosts Active Now",
      "type": "stat",
      "description": "Count of hosts that sent at least one log line in the last 5 minutes. \"Active\" here means 5-minute recency - a low-traffic device that legitimately only logs every 10-15 minutes could show as inactive even though it's fine; adjust the [5m] window in this panel and the two below if that's too aggressive for your devices.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 50 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(sum by (host) (count_over_time({job=\"syslog\"} [5m])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 15,
      "title": "Hosts Gone Silent",
      "type": "stat",
      "description": "Hosts that sent logs at some point in the last 24h (so we know about them) but nothing in the last 5 minutes - likely offline, disconnected, or their forwarding agent stopped.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 50 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(sum by (host) (count_over_time({job=\"syslog\"} [24h])) unless sum by (host) (count_over_time({job=\"syslog\"} [5m])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 16,
      "title": "Active Hosts (sent logs in last 5m)",
      "type": "bargauge",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (host) (count_over_time({job=\"syslog\"} [5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 17,
      "title": "Inactive Hosts (seen in 24h, silent 5m+)",
      "type": "bargauge",
      "description": "Value shown is total events in the last 24h - useful to gauge whether it was a chatty host that suddenly stopped, or a quiet one. Empty panel = nothing has gone quiet.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (host) (count_over_time({job=\"syslog\"} [24h])) unless sum by (host) (count_over_time({job=\"syslog\"} [5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": { "orientation": "horizontal" }
    }
  ]
}
